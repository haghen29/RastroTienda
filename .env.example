# ─────────────── Básico ───────────────
NEXT_PUBLIC_SITE_URL=https://rastroperfumeria.com
DATABASE_FILE=./rastro.db

# ─────────────── Administrador ───────────────
ADMIN_PASSWORD=cambiala-por-una-larga
ADMIN_SECRET=una-cadena-random-larga-para-firmar-la-cookie

# ─────────────── Mercado Pago (tarjetas y cuotas) ───────────────
# Panel: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
# Configurá el webhook en MP apuntando a:
#   https://TU-DOMINIO/api/webhooks/mercadopago

# ─────────────── Transferencia ───────────────
TRANSFER_ALIAS=rastro.perfumeria
TRANSFER_CBU=
TRANSFER_HOLDER=Rastro Perfumeria
TRANSFER_BANK=
# Descuento por pagar transfiriendo (0 = sin descuento)
TRANSFER_DISCOUNT_PCT=0

# ─────────────── Envíos ───────────────
# Si dejás esto vacío se usa el tarifario propio de src/lib/shipping/table.ts
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CLIENTE=
ANDREANI_CONTRATO_DOMICILIO=
ANDREANI_CONTRATO_SUCURSAL=
ANDREANI_CP_ORIGEN=1884
# Envío gratis a partir de este monto en pesos (0 = desactivado)
FREE_SHIPPING_FROM=0
# Monto mínimo de compra en pesos (0 = sin mínimo)
MINIMUM_ORDER=0

# ─────────────── Email ───────────────
# https://resend.com — sin esta key los mails se loguean por consola
RESEND_API_KEY=
MAIL_FROM=Rastro Perfumeria <pedidos@tudominio.com>
MERCHANT_EMAIL=rastro.fragances@gmail.com

# ─────────────── WhatsApp (opcional) ───────────────
# Sin esto igual funcionan los links wa.me; esto es sólo para avisos automáticos
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
